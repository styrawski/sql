-- 		podpunkt 1
create table `zadanie` (
`id_zadania` int primary key not null auto_increment,
`nazwa_zadania` varchar(150) not null,
`priorytet` enum('normalny','wysoki', 'niski'),
`opis` longtext,
`pracownik` int, foreign key (`pracownik`) references pracownik(`id_pracownika`) on delete cascade
);

-- 		podpunkt 2
alter table `zadanie` alter column `priorytet` set default 'normalny';


-- 		podpunkt 3
insert into `zadanie` (
`nazwa_zadania`,
`opis`,
`pracownik`
)values
('zadanie 1', 'jakies zadanie', (select `id_pracownika` from `pracownik` where `nazwisko` = 'kowalenko')),
('zadanie 2', 'jakies inne zadanie', 2),
('zadanie 3', 'jakies jeszcze inne zadanie', (select `id_pracownika` from `pracownik` where `data_urodzenia` = '2078-12-01'));

select * from `zadanie`;
drop table `zadanie`;

